    },
    "feed": {
      ".read": true,
      ".indexOn": ["time"],
      "$e": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['product', 'time']) && !newData.hasChild('email') && !newData.hasChild('uid')"
      }
    },
    "orders": {      ".read": "auth != null && (auth.token.email == 'gourobsarkar99@gmail.com' || auth.token.email == 'mdswampodsarkar@gmail.com')",
